# ------------------------------------------------------------------
# App-Creator environment variables
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres connection string, used for migrations/tooling)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI provider (Anthropic Claude powers the app builder chat)
ANTHROPIC_API_KEY=your-anthropic-api-key

# NVIDIA Inference API (NIM) — text & code generation endpoints
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key
# Optional overrides (defaults shown)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_CODE_MODEL=qwen/qwen2.5-coder-32b-instruct
# Requests per minute per user for the NVIDIA endpoints
NVIDIA_RATE_LIMIT_RPM=20

# Product analytics (PostHog) — optional
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Billing — Paystack (https://dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
# Optional: a Paystack Plan code enables provider-side auto-renewal
PAYSTACK_PLAN_CODE_PRO=

# Billing — Flutterwave (https://app.flutterwave.com → Settings → API)
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# Webhook secret hash (Settings → Webhooks) — verifies webhook calls
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# Charge currency for checkout (must be enabled on your provider account)
BILLING_CURRENCY=USD
