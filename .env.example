# ------------------------------------------------------------------
# App-Creator environment variables
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional split-domain architecture: set to the app subdomain (e.g.
# app.buildrx.online) to serve marketing pages on the apex and the
# product on this host. Leave unset for single-host/local/preview.
NEXT_PUBLIC_APP_HOST=

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: the modern publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback: the JWT anon key (used when no publishable key is set)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Sign-In needs NO env vars here — the Google OAuth client ID/secret
# are configured in the Supabase dashboard (Authentication -> Providers ->
# Google). See docs/google-oauth.md for the full setup (redirect URLs etc).

# Database (Supabase Postgres connection string, used for migrations/tooling)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI providers — chat and the agent build pipeline try each configured
# tier in order and fall back automatically:
#
#   OpenRouter (strong -> everyday)  ->  NVIDIA (GLM -> Step -> Llama)
#
# Either provider alone is enough to generate for real. Without any key
# the app degrades gracefully to demo/mock output.
#
# OpenRouter is recommended as the primary: the free NVIDIA tier often
# fails to answer inside a build step's time budget, which leaves every
# generated app as a built-in scaffold rather than your description.

# OpenRouter — https://openrouter.ai/keys. Billed per token.
OPENROUTER_API_KEY=your-openrouter-api-key
# Model routing is automatic. Each task role picks the best model its key
# can actually call, from the families this project standardises on:
#
#   planning/architecture  DeepSeek R1 -> DeepSeek V3 -> Qwen 72B -> Kimi -> GLM -> Llama 70B
#   application code       Qwen Coder -> DeepSeek -> Codestral -> Qwen 72B -> Llama 70B
#   UI / schema / repairs  Qwen Coder -> Codestral -> Mistral Small -> Gemma -> DeepSeek
#   diagnostics            Llama 8B -> Mistral Small -> Gemma -> Qwen Coder
#   light tasks            Gemma -> Llama 8B -> Mistral Small
#
# The ladders are filtered against OpenRouter's live catalog, so an id
# your account cannot call is skipped rather than failing the build (this
# is how "Kimi when available" works). See the resolved choices at
# /api/ai/health under "openrouter.models".
#
# These two override the routing entirely, if you want a fixed model.
# STRONG covers planning and application code; the other covers review,
# diagnostics, light tasks and chat.
# OPENROUTER_MODEL_STRONG=openai/gpt-4o
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: shown on OpenRouter's activity dashboard.
OPENROUTER_APP_NAME=BuildRx
# Optional endpoint override (default shown).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA Inference API (NIM) — free fallback tier. Key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key
# Optional override (default shown). NVIDIA_API_BASE_URL is also accepted.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Provider-chain models (primary NVIDIA tier, then its own fallback tier)
NVIDIA_GLM_MODEL=z-ai/glm-5.2
NVIDIA_LLAMA_MODEL=meta/llama-3.2-1b-instruct
# Task-complexity model routing for the agent pipeline (all optional —
# unset roles fall back to the models above). Set each to the exact id
# from the NVIDIA NIM catalog (https://build.nvidia.com):
#   DEEPSEEK_PRO   — deep reasoning, architecture, primary coding
#   DEEPSEEK_FLASH — fast debugging and diagnostics
#   MISTRAL_LARGE  — code generation and review
#   MISTRAL_MEDIUM — lightweight tasks
#   KIMI           — general-purpose fallback tier
NVIDIA_MODEL_DEEPSEEK_PRO=
NVIDIA_MODEL_DEEPSEEK_FLASH=
NVIDIA_MODEL_MISTRAL_LARGE=
NVIDIA_MODEL_MISTRAL_MEDIUM=
NVIDIA_MODEL_KIMI=
# Role-specialized models used elsewhere (code generation, the /api/ai/*
# endpoints) — independent of the GLM/Llama provider-chain tiers above.
NVIDIA_TEXT_MODEL=z-ai/glm-5.2
NVIDIA_CODE_MODEL=poolside/laguna-xs-2.1
NVIDIA_CHAT_MODEL=stepfun-ai/step-3.7-flash
# Requests per minute per user for the NVIDIA endpoints
NVIDIA_RATE_LIMIT_RPM=20

# Anthropic Claude — OPTIONAL, OFF BY DEFAULT. Leave both of these unset
# to stay on NVIDIA's free models only. Anthropic is a paid API: enabling
# it with an unfunded account makes requests fail with "credit balance is
# too low" instead of falling back, which is why the key alone is not
# enough to turn it on — ANTHROPIC_ENABLED must also be true.
# ANTHROPIC_ENABLED=true
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Product analytics (PostHog) — optional
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Billing — Paystack (https://dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
# Optional: a Paystack Plan code enables provider-side auto-renewal
PAYSTACK_PLAN_CODE_PRO=

# Billing — Flutterwave (https://app.flutterwave.com → Settings → API)
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# Webhook secret hash (Settings → Webhooks) — verifies webhook calls
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# Charge currency for checkout (must be enabled on your provider account)
BILLING_CURRENCY=USD
