# ------------------------------------------------------------------
# App-Creator environment variables
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional split-domain architecture: set to the app subdomain (e.g.
# app.buildrx.online) to serve marketing pages on the apex and the
# product on this host. Leave unset for single-host/local/preview.
NEXT_PUBLIC_APP_HOST=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres connection string, used for migrations/tooling)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI provider (Anthropic Claude powers the app builder chat)
ANTHROPIC_API_KEY=your-anthropic-api-key

# NVIDIA Inference API (NIM) — text & code generation endpoints
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key
# Optional overrides (defaults shown)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=z-ai/glm-5.2
NVIDIA_CODE_MODEL=poolside/laguna-xs-2.1
NVIDIA_CHAT_MODEL=stepfun-ai/step-3.7-flash
# Requests per minute per user for the NVIDIA endpoints
NVIDIA_RATE_LIMIT_RPM=20

# NVIDIA — vision (image/screenshot understanding, image-to-code)
# Same key/endpoint as above, OpenAI-compatible multimodal chat completions.
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# NVIDIA — content safety (moderates chat prompts before they reach a model)
NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3

# NVIDIA — build planning (long-context multi-file plan before code-gen)
NVIDIA_PLAN_MODEL=qwen/qwen3-next-80b-a3b-instruct

# NVIDIA — document/image parsing (extracts text & structure from an image)
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse

# NVIDIA — text-to-image (hero art, icons, placeholders for generated apps)
# Uses a separate per-model REST endpoint, not /chat/completions. The
# default below matches NVIDIA's documented pattern at time of writing;
# if it 404s, copy the exact URL from this model's "API" tab on
# build.nvidia.com and set it here.
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-3.5-large
NVIDIA_IMAGE_API_URL=https://ai.api.nvidia.com/v1/genai/stabilityai/stable-diffusion-3.5-large

# NVIDIA — voice input (speech-to-text for the chat composer)
# Hosted Parakeet endpoints are per-model NVCF invocation URLs with no
# stable default — copy the exact URL from this model's "API" tab on
# build.nvidia.com. Voice input stays disabled until this is set.
NVIDIA_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v2
NVIDIA_ASR_API_URL=

# Product analytics (PostHog) — optional
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Billing — Paystack (https://dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
# Optional: a Paystack Plan code enables provider-side auto-renewal
PAYSTACK_PLAN_CODE_PRO=

# Billing — Flutterwave (https://app.flutterwave.com → Settings → API)
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# Webhook secret hash (Settings → Webhooks) — verifies webhook calls
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# Charge currency for checkout (must be enabled on your provider account)
BILLING_CURRENCY=USD
