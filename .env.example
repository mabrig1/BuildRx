# ------------------------------------------------------------------
# App-Creator environment variables
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional split-domain architecture: set to the app subdomain (e.g.
# app.buildrx.online) to serve marketing pages on the apex and the
# product on this host. Leave unset for single-host/local/preview.
NEXT_PUBLIC_APP_HOST=

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: the modern publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback: the JWT anon key (used when no publishable key is set)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Sign-In needs NO env vars here — the Google OAuth client ID/secret
# are configured in the Supabase dashboard (Authentication -> Providers ->
# Google). See docs/google-oauth.md for the full setup (redirect URLs etc).

# Database (Supabase Postgres connection string, used for migrations/tooling)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI providers — chat and the agent build pipeline try these in order
# and fall back automatically: NVIDIA GLM -> NVIDIA Llama -> Anthropic
# Claude. Configure either or both; the app degrades gracefully (down to
# a demo/mock reply) if neither key is set.

# NVIDIA Inference API (NIM) — primary provider. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key
# Optional override (default shown). NVIDIA_API_BASE_URL is also accepted.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Provider-chain models (primary NVIDIA tier, then its own fallback tier)
NVIDIA_GLM_MODEL=z-ai/glm-5.2
NVIDIA_LLAMA_MODEL=meta/llama-3.2-1b-instruct
# Role-specialized models used elsewhere (code generation, the /api/ai/*
# endpoints) — independent of the GLM/Llama provider-chain tiers above.
NVIDIA_TEXT_MODEL=z-ai/glm-5.2
NVIDIA_CODE_MODEL=poolside/laguna-xs-2.1
NVIDIA_CHAT_MODEL=stepfun-ai/step-3.7-flash
# Requests per minute per user for the NVIDIA endpoints
NVIDIA_RATE_LIMIT_RPM=20

# Anthropic Claude — fallback provider for chat and the agent build
# pipeline. (The dedicated /api/ai/code and /api/ai/generate endpoints
# are NVIDIA-only by design and unaffected by this key.)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Product analytics (PostHog) — optional
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Billing — Paystack (https://dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
# Optional: a Paystack Plan code enables provider-side auto-renewal
PAYSTACK_PLAN_CODE_PRO=

# Billing — Flutterwave (https://app.flutterwave.com → Settings → API)
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# Webhook secret hash (Settings → Webhooks) — verifies webhook calls
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# Charge currency for checkout (must be enabled on your provider account)
BILLING_CURRENCY=USD
